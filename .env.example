# Copy to .env.local for Next.js. Provider integrations are not enabled yet.
APP_ENV=development
APP_ORIGIN=http://localhost:3000
# Server-only configuration; placeholders, never real credentials.
# DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/rce_billing
# DATABASE_MIGRATION_URL=postgresql://MIGRATOR:PASSWORD@localhost:5432/rce_billing
# TEST_DATABASE_URL=postgresql://TEST_USER:TEST_PASSWORD@localhost:5432/postgres
# STRIPE_SECRET_KEY=REPLACE_WITH_TEST_KEY
# STRIPE_WEBHOOK_SECRET=REPLACE_WITH_TEST_SECRET

# Google Workspace administrator sign-in (Web application OAuth client)
# GOOGLE_OAUTH_CLIENT_ID=...
# GOOGLE_OAUTH_CLIENT_SECRET=...

# Use a generated 32-byte base64 key; keep old versions available for decryption.
# FLOWROUTE_ENCRYPTION_KEY_VERSION=v1
# FLOWROUTE_ENCRYPTION_KEYS={"v1":"REPLACE_WITH_BASE64_KEY"}

# Phase 5 is test-mode only; production activation remains blocked.
STRIPE_TEST_ENABLED=false
# STRIPE_SECRET_KEY=sk_test_REPLACE_WITH_SANDBOX_KEY
# STRIPE_WEBHOOK_SECRET=whsec_REPLACE_WITH_SIGNING_SECRET
# STRIPE_ACCOUNT_ID=acct_REPLACE_WITH_SANDBOX_ACCOUNT_ID
