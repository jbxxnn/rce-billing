# Local development configuration template. Copy this file to .env.local and
# replace every placeholder with values from your environment's secret store.
APP_ENV=development
APP_ORIGIN=http://localhost:3000

# PostgreSQL
DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/rce_billing
DATABASE_MIGRATION_URL=postgresql://MIGRATOR:PASSWORD@localhost:5432/rce_billing
TEST_DATABASE_URL=postgresql://TEST_USER:TEST_PASSWORD@localhost:5432/postgres

# Stripe test mode only. Never commit live or sandbox credentials.
STRIPE_TEST_ENABLED=true
STRIPE_SECRET_KEY=sk_test_REPLACE_WITH_SANDBOX_KEY
STRIPE_WEBHOOK_SECRET=whsec_REPLACE_WITH_TEST_WEBHOOK_SECRET
STRIPE_ACCOUNT_ID=acct_REPLACE_WITH_SANDBOX_ACCOUNT_ID

# Google Workspace administrator sign-in
GOOGLE_OAUTH_CLIENT_ID=REPLACE_WITH_GOOGLE_OAUTH_CLIENT_ID
GOOGLE_OAUTH_CLIENT_SECRET=REPLACE_WITH_GOOGLE_OAUTH_CLIENT_SECRET

# Flowroute encryption. Use a generated 32-byte base64 key.
FLOWROUTE_ENCRYPTION_KEY_VERSION=v1
FLOWROUTE_ENCRYPTION_KEYS={"v1":"REPLACE_WITH_BASE64_KEY"}
