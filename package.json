{
  "name": "rce-billing",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24 <27"
  },
  "scripts": {
    "dev": "next dev",
    "dev:workers": "vinext dev",
    "build": "vinext build",
    "deploy:staging": "npx @vinext/cloudflare deploy --env staging",
    "deploy:production": "npx @vinext/cloudflare deploy --env production",
    "build:next": "next build",
    "start": "next start",
    "preview": "vite preview",
    "lint": "eslint .",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check:compatibility": "vinext check",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx scripts/db/migrate-cli.ts",
    "db:seed": "tsx scripts/db/seed-cli.ts",
    "test:db": "vitest run --config vitest.db.config.ts",
    "auth:admin": "tsx scripts/auth/admin-cli.ts",
    "auth:cleanup": "tsx scripts/auth/cleanup.ts",
    "test:auth": "vitest run --config vitest.auth.config.ts",
    "test:stripe:sandbox": "vitest run --config vitest.stripe.config.ts",
    "stripe:replay": "node --conditions=react-server --env-file-if-exists=.env.local --import tsx scripts/stripe/replay-events.ts",
    "stripe:aisha-reconciliation": "node --conditions=react-server --env-file-if-exists=.env.local --import tsx scripts/stripe/create-aisha-reconciliation.ts",
    "flowroute:process": "node --conditions=react-server --env-file-if-exists=.env.local --import tsx scripts/flowroute/process-export.ts",
    "flowroute:request": "node --conditions=react-server --env-file-if-exists=.env.local --import tsx scripts/flowroute/request-export.ts",
    "flowroute:replay": "node --conditions=react-server --env-file-if-exists=.env.local --import tsx scripts/flowroute/replay-job.ts",
    "mcp:start": "node --conditions=react-server --import tsx scripts/mcp/start.ts",
    "mcp:start:production": "node --conditions=react-server --env-file-if-exists=.env.production.local --import tsx scripts/mcp/start-production.ts",
    "mcp:verify": "node --conditions=react-server --import tsx scripts/mcp/verify.ts",
    "mcp:smoke": "node --conditions=react-server --env-file-if-exists=.env.local --import tsx scripts/mcp/smoke.ts",
    "mcp:smoke:production": "RCE_BILLING_MCP_PRODUCTION=true node --conditions=react-server --env-file-if-exists=.env.production.local --import tsx scripts/mcp/smoke.ts"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/modifiers": "^9.0.0",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@modelcontextprotocol/sdk": "^1.30.1",
    "@radix-ui/react-slot": "^1.3.3",
    "@tabler/icons-react": "^3.48.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@tanstack/react-table": "^9.2.4",
    "bcryptjs": "3.0.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cn": "^0.4.0",
    "dotenv": "^18.0.3",
    "drizzle-orm": "0.45.3",
    "jose": "^6.2.12",
    "lucide-react": "^1.48.0",
    "next": "16.3.5",
    "next-themes": "^0.4.6",
    "pg": "8.23.0",
    "radix-ui": "^1.6.7",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-server-dom-webpack": "19.3.0",
    "recharts": "^3.8.0",
    "server-only": "0.0.1",
    "sonner": "^2.0.8",
    "stripe": "22.6.2",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.3",
    "vaul": "^1.1.2",
    "vinext": "1.0.0-beta.11",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.57.2",
    "@types/node": "24.13.6",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "@vitejs/plugin-rsc": "0.5.35",
    "drizzle-kit": "0.31.11",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.5",
    "prettier": "3.9.8",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "vite": "8.3.0",
    "vitest": "5.0.1",
    "wrangler": "4.136.2"
  },
  "overrides": {
    "@esbuild-kit/core-utils": {
      "esbuild": "0.25.12"
    }
  }
}
